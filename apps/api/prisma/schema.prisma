datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum HabitType {
  BUILD
  BREAK
}

enum ScheduleType {
  DAILY
  SPECIFIC_DAYS
  TIMES_PER_WEEK
  INTERVAL
}

enum LogStatus {
  DONE
  PARTIAL
  SKIPPED
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlanInterval {
  ONE_TIME
  MONTH
  YEAR
  FOREVER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email     String  @unique @db.VarChar(255)
  name      String  @db.VarChar(60)
  avatarUrl String? @db.VarChar(500)

  passwordHash String? @db.VarChar(72)

  timezone     String   @default("Asia/Dhaka") @db.VarChar(64)
  weekStartsOn Int      @default(6) @db.SmallInt
  role         UserRole @default(CUSTOMER)

  emailVerifiedAt DateTime?
  lastActiveAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  habits             Habit[]
  logs               HabitLog[]
  devices            Device[]
  refreshTokens      RefreshToken[]
  accounts           OAuthAccount[]
  emailTokens        EmailToken[]
  plansCreated       Plan[]             @relation("PlanCreatedBy")
  plansUpdated       Plan[]             @relation("PlanUpdatedBy")
  planSubscriptions  PlanSubscription[]

  @@index([deletedAt])
  @@map("users")
}

model OAuthAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  provider          String @db.VarChar(20)
  providerAccountId String @db.VarChar(255)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String @unique @db.VarChar(64)

  deviceId  String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)
  ipAddress String? @db.VarChar(45)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  tokenHash String         @unique @db.VarChar(64)
  type      EmailTokenType

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("email_tokens")
}

model Habit {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  title       String    @db.VarChar(80)
  description String?   @db.VarChar(500)
  icon        String    @default("check") @db.VarChar(32)
  color       String    @default("#2B4CE0") @db.VarChar(7)
  type        HabitType @default(BUILD)

  scheduleType  ScheduleType @default(DAILY)
  scheduleDays  Int[]        @default([])
  targetPerWeek Int?         @db.SmallInt
  intervalDays  Int?         @db.SmallInt

  targetValue Float?
  unit        String? @db.VarChar(24)

  startDate DateTime @db.Date

  sortOrder  Int       @default(0)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      HabitLog[]
  reminders Reminder[]

  @@index([userId, archivedAt, sortOrder])
  @@map("habits")
}

model HabitLog {
  id      String @id @default(uuid()) @db.Uuid
  habitId String @db.Uuid
  userId  String @db.Uuid

  localDate DateTime @db.Date

  status LogStatus @default(DONE)
  value  Float?
  note   String?   @db.VarChar(280)

  completedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, localDate])
  @@index([userId, localDate])
  @@index([habitId, localDate(sort: Desc)])
  @@map("habit_logs")
}

model Reminder {
  id      String @id @default(uuid()) @db.Uuid
  habitId String @db.Uuid

  timeLocal String @db.VarChar(5)

  daysOfWeek Int[]   @default([0, 1, 2, 3, 4, 5, 6])
  enabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([enabled, timeLocal])
  @@index([habitId])
  @@map("reminders")
}

model Device {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  platform DevicePlatform

  pushToken String @unique @db.VarChar(512)

  deviceName String?  @db.VarChar(60)
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@map("devices")
}

model Plan {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(64)
  name String @db.VarChar(80)
  blurb String @db.VarChar(280)

  priceCents    Int
  currency      String      @default("USD") @db.VarChar(3)
  interval      PlanInterval
  intervalCount Int         @default(1)
  seatBased     Boolean     @default(false)

  highlighted Boolean    @default(false)
  sortOrder   Int        @default(0)
  status      PlanStatus @default(DRAFT)

  ctaLabel String  @default("Get started") @db.VarChar(40)
  ctaHref  String  @default("/register") @db.VarChar(200)

  limits Json @default("{}")

  publishedAt DateTime?
  currentVersion Int @default(1)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy     User?              @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?              @relation("PlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  features      PlanFeature[]
  versions      PlanVersion[]
  subscriptions PlanSubscription[]

  @@index([status, sortOrder])
  @@index([highlighted, status])
  @@map("plans")
}

model PlanFeature {
  id        String @id @default(uuid()) @db.Uuid
  planId    String @db.Uuid
  label     String @db.VarChar(120)
  sortOrder Int    @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("plan_features")
}

model PlanVersion {
  id     String @id @default(uuid()) @db.Uuid
  planId String @db.Uuid
  version Int

  priceCents    Int
  currency      String       @db.VarChar(3)
  interval      PlanInterval
  intervalCount Int
  seatBased     Boolean
  limits        Json

  createdAt DateTime @default(now())
  createdById String? @db.Uuid

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, version])
  @@index([planId])
  @@map("plan_versions")
}

model PlanSubscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  planId String @db.Uuid

  status SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@index([userId])
  @@map("plan_subscriptions")
}
