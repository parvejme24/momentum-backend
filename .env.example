NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Postgres (Neon) ----
# pooled — সাধারণ query
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/momentum?sslmode=require
# direct — শুধু migration
DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/momentum?sslmode=require

# ---- Redis (Redis Cloud) ----
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
REDIS_TLS=true

# ---- Auth ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- App ----
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Momentum <noreply@momentum.app>

# ---- Web Push ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:devparvej@gmail.com
