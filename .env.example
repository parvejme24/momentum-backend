NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Postgres (Neon) ----
# pooled — সাধারণ query
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/momentum?sslmode=require
# direct — শুধু migration
DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/momentum?sslmode=require

# ---- Redis (Redis Cloud) ----
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
REDIS_TLS=true

# ---- Auth ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=

# ---- Gemini AI (Pro habit ideas & messages) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- App ----
CORS_ORIGINS=http://localhost:3000,https://momentum-pvj.vercel.app,https://momentum-frontend-pi.vercel.app
APP_URL=http://localhost:3000
# Backend public URL (SSLCommerz IPN). Local dev example:
# API_URL=http://localhost:4000

# ---- Cloudinary (avatars / uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- SSLCommerz (Bangladesh payments) ----
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
# Optional — defaults use APP_URL / API_URL
# SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/payment/return?sslcommerz=success
# SSLCOMMERZ_FAIL_URL=http://localhost:3000/payment/return?sslcommerz=fail
# SSLCOMMERZ_CANCEL_URL=http://localhost:3000/payment/return?sslcommerz=cancel
# SSLCOMMERZ_IPN_URL=http://localhost:4000/v1/billing/sslcommerz/ipn

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Momentum <noreply@momentum.app>

# ---- Web Push ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:devparvej@gmail.com

# ---- Stripe ----
# Secret stays on the server. Publishable key is returned by GET /v1/billing/config.
SECRET_KEY=
PUBLISHABLE_KEY=
# Optional aliases:
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
